---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ResultsGallery from '../components/ResultsGallery.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<BaseLayout 
  title="Resultados Antes e Depois | Auto Recuperadora Bruning"
  description="Veja imagens reais de transformações automotivas executadas na Auto Recuperadora Bruning em Caxias do Sul."
>
  <div class="pt-28 pb-12 bg-[#070707] text-center border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4">
      <span class="text-xs font-bold uppercase tracking-wider text-[#f1262d]">Portfólio de Trabalhos</span>
      <h1 class="text-4xl sm:text-5xl font-black text-white mt-2">Resultados que Entregam Confiança</h1>
      <p class="text-gray-400 text-base mt-4 max-w-2xl mx-auto">
        Imagens reais de veículos recuperados por nossa equipe em Caxias do Sul.
      </p>
    </div>
  </div>

  <BeforeAfter />
  <ResultsGallery />
  <CtaBanner />
</BaseLayout>
