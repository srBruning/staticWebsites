---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import InteractiveQuote from '../components/InteractiveQuote.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<BaseLayout 
  title="Serviços de Chapeação e Pintura | Auto Recuperadora Bruning"
  description="Conheça todos os nossos serviços: chapeação, pintura em estufa, retoques, polimento e revitalização de faróis em Caxias do Sul."
>
  <div class="pt-28 pb-12 bg-[#070707] text-center border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4">
      <span class="text-xs font-bold uppercase tracking-wider text-[#f1262d]">Especialidades Bruning</span>
      <h1 class="text-4xl sm:text-5xl font-black text-white mt-2">Nossos Serviços Especializados</h1>
      <p class="text-gray-400 text-base mt-4 max-w-2xl mx-auto">
        Técnicas avançadas para restaurar a estética, a proteção e o valor de mercado do seu automóvel.
      </p>
    </div>
  </div>

  <ServicesGrid />
  <InteractiveQuote />
  <CtaBanner />
</BaseLayout>
