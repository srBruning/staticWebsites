---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { business } from '../data/business';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = `${business.name} | Chapeação e Pintura Automotiva em Caxias do Sul`,
  description = business.description,
  image = '/images/gallery/cars01.jpg',
  canonicalUrl = Astro.url.href,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  'name': business.name,
  'image': `${Astro.site}${image.replace(/^\//, '')}`,
  'description': business.description,
  'url': Astro.site ? Astro.site.href : canonicalUrl,
  'telephone': business.phones[0].label,
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': business.address.street,
    'addressLocality': business.address.city,
    'addressRegion': business.address.state,
    'addressCountry': business.address.country,
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': -29.1833,
    'longitude': -51.1833,
  },
  'areaServed': 'Caxias do Sul e Serra Gaúcha',
  'sameAs': [business.instagramUrl],
  'priceRange': '$$',
};
---

<!usr/bin/env html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://autobruning.dibr3.com')} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site || 'https://autobruning.dibr3.com')} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts: Montserrat & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Global CSS imported via Astro Frontmatter -->

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[#070707] text-white min-h-screen flex flex-col font-sans selection:bg-[#f1262d] selection:text-white">
    <Header />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
  </body>
</html>
