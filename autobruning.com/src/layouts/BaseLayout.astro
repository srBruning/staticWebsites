---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { business } from '../data/business';
import { getImage } from 'astro:assets';
import heroImage from '../assets/capa_01.jpeg';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const preloadedHero = await getImage({ src: heroImage, format: 'webp' });

const {
  title = `${business.name} | Auto Recuperadora, Chapeação e Pintura Automotiva em Caxias do Sul`,
  description = "Bateu ou arranhou o carro? A Auto Recuperadora Bruning é especialista em chapeação, pintura estufa e revitalização de faróis em Caxias do Sul. Faça orçamento via WhatsApp!",
  image = preloadedHero.src,
  canonicalUrl = Astro.url.href,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  'name': business.name,
  'image': `${Astro.site || 'https://autobruning.com'}${image.replace(/^\//, '')}`,
  'description': description,
  'url': Astro.site ? Astro.site.href : canonicalUrl,
  'telephone': business.phones[0].label,
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': business.address.street,
    'addressLocality': business.address.city,
    'addressRegion': business.address.state,
    'addressCountry': business.address.country,
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': -29.19720614143396,
    'longitude': -51.20187893119833,
  },
  'areaServed': 'Caxias do Sul e Serra Gaúcha',
  'sameAs': [business.instagramUrl],
  'priceRange': '$$',
};
---

<!usr/bin/env html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- LCP Preload -->
    <link rel="preload" as="image" href={preloadedHero.src} type="image/webp" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://autobruning.dibr3.com')} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site || 'https://autobruning.dibr3.com')} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts: Montserrat & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Global CSS imported via Astro Frontmatter -->

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[#070707] text-white min-h-screen flex flex-col font-sans selection:bg-[#f1262d] selection:text-white">
    <Header />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />

    <script>
      const observerCallback = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
        entries.forEach((entry: IntersectionObserverEntry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      };

      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -10% 0px',
        threshold: 0.1
      };

      // Initialize on client
      if (typeof window !== 'undefined') {
        const observer = new IntersectionObserver(observerCallback, observerOptions);
        const elements = document.querySelectorAll('.reveal-on-scroll');
        elements.forEach(el => observer.observe(el));
      }
    </script>
  </body>
</html>
