---
import { services } from '../data/services';
import { business } from '../data/business';
---

<section id="servicos" class="py-24 bg-[#070707] relative">
  <!-- Subtle decorative background glow -->
  <div class="absolute top-1/2 left-0 w-80 h-80 bg-[#f1262d]/10 rounded-full filter blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f1262d]/10 text-[#f1262d] text-xs font-bold uppercase tracking-wider">
        <span>Nossas Soluções</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
        Cuidado completo para recuperar o <span class="text-[#f1262d]">visual do seu carro</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg">
        Serviços especializados de funilaria, repintura e estética automotiva executados por quem prioriza o padrão de acabamento.
      </p>
    </div>

    <!-- Grid of Services -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="bg-[#111111] rounded-2xl border border-white/10 hover:border-[#f1262d]/50 transition-all duration-300 flex flex-col overflow-hidden group hover:-translate-y-1 hover:shadow-xl hover:shadow-[#f1262d]/10">
          <!-- Service Card Header Image -->
          <div class="relative h-48 overflow-hidden bg-black">
            <img 
              src={service.image} 
              alt={service.title} 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#111111] via-[#111111]/40 to-transparent"></div>
            <div class="absolute top-4 left-4">
              <span class="bg-[#f1262d] text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow">
                {service.title.split(' ')[0]}
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-6 flex-grow flex flex-col justify-between space-y-6">
            <div class="space-y-3">
              <h3 class="text-xl font-bold text-white group-hover:text-[#f1262d] transition-colors">
                {service.title}
              </h3>
              <p class="text-sm text-gray-300 leading-relaxed">
                {service.summary}
              </p>
              
              <!-- Features List -->
              <ul class="space-y-2 pt-2 border-t border-white/5">
                {service.features.map(feat => (
                  <li class="flex items-center gap-2 text-xs text-gray-400">
                    <svg class="w-3.5 h-3.5 text-[#f1262d] shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Card Action -->
            <div class="pt-2">
              <a 
                href={business.getWhatsappUrl(`Olá! Gostaria de um orçamento para o serviço de ${service.title} para meu veículo.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 bg-[#191919] hover:bg-[#f1262d] text-white text-sm font-bold py-3 rounded-xl transition-all border border-white/10 hover:border-[#f1262d] group/btn"
              >
                <span>Orçamento para {service.title.split(' ')[0]}</span>
                <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
