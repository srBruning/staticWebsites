---
import { business } from '../data/business';
---

<section class="py-20 bg-gradient-to-r from-[#e31e24] via-[#f1262d] to-[#e31e24] relative overflow-hidden text-white shadow-2xl">
  <!-- Subtle pattern background -->
  <div class="absolute inset-0 pattern-checkers opacity-20 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-6">
    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white drop-shadow-md">
      Arranhou, amassou ou riscou?
    </h2>
    <p class="text-lg sm:text-xl text-white/90 max-w-2xl mx-auto font-medium">
      Fale com quem entende do assunto em Caxias do Sul. Solicite uma avaliação rápida sem compromisso.
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href={business.getWhatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-black hover:bg-[#070707] text-white text-base sm:text-lg font-bold px-9 py-4 rounded-xl transition-all shadow-2xl hover:scale-105 active:scale-95 group border border-white/10"
      >
        <svg class="w-6 h-6 fill-[#f1262d] transition-transform group-hover:rotate-6" viewBox="0 0 24 24">
          <path d="M12.031 0C5.394 0 0 5.394 0 12.031c0 2.124.555 4.198 1.608 6.02L0 24l6.168-1.617a12.007 12.007 0 005.863 1.516h.005c6.637 0 12.031-5.394 12.031-12.031 0-3.212-1.251-6.234-3.522-8.505C18.275 1.091 15.244 0 12.031 0zm0 22.062h-.005a10.024 10.024 0 01-5.109-1.396l-.366-.217-3.792.994 1.012-3.696-.239-.38a10.028 10.028 0 01-1.536-5.336c0-5.541 4.51-10.05 10.05-10.05 2.684 0 5.207 1.045 7.105 2.943 1.898 1.898 2.943 4.421 2.943 7.105 0 5.542-4.509 10.051-10.065 10.051zm5.51-7.534c-.302-.151-1.787-.882-2.063-.982-.276-.101-.478-.151-.68.151-.202.302-.781.982-.957 1.183-.176.202-.352.226-.654.076-.302-.151-1.275-.47-2.428-1.499-.897-.8-1.502-1.789-1.678-2.091-.176-.302-.019-.465.132-.615.136-.135.302-.352.453-.528.151-.176.202-.302.302-.503.101-.202.05-.377-.025-.528-.075-.151-.68-1.636-.931-2.239-.244-.587-.492-.507-.68-.517h-.578c-.202 0-.528.075-.805.377s-1.056 1.032-1.056 2.518 1.081 2.917 1.232 3.118c.151.202 2.128 3.25 5.156 4.557.72.311 1.282.497 1.721.637.723.23 1.381.197 1.901.12.58-.087 1.787-.73 2.039-1.433.252-.704.252-1.308.176-1.433-.075-.126-.276-.202-.578-.353z"/>
        </svg>
        <span>Chamar no WhatsApp</span>
      </a>

      <a 
        href="tel:+5554981365147"
        class="inline-flex items-center justify-center gap-2 border-2 border-white/40 hover:border-white text-white text-base font-bold px-7 py-4 rounded-xl transition-all"
      >
        <span>Ligar: (54) 98136-5147</span>
      </a>
    </div>
  </div>
</section>
