---
import { business } from '../data/business';
---

<section class="py-20 bg-[#070707] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-[#111111] via-[#191919] to-[#070707] rounded-3xl border border-[#f1262d]/30 p-8 sm:p-12 lg:p-16 relative overflow-hidden shadow-2xl">
      
      <!-- Background Graphic Accents -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-[#f1262d]/10 rounded-full filter blur-[100px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 opacity-10 pointer-events-none">
        <svg class="w-96 h-96 text-[#f1262d]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
        </svg>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
        
        <!-- Image Box -->
        <div class="lg:col-span-6 relative">
          <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl group">
            <img 
              src="/images/gallery/idvisu04.jpg" 
              alt="Revitalização de faróis na Auto Recuperadora Bruning" 
              class="w-full h-80 object-cover object-center group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs font-bold text-white bg-black/60 backdrop-blur-md px-4 py-2 rounded-xl border border-white/10">
              <span class="flex items-center gap-2 text-[#f1262d]">
                <span class="w-2 h-2 rounded-full bg-[#f1262d] animate-ping"></span>
                Resultado Imediato
              </span>
              <span class="text-gray-300">Proteção UV Duradoura</span>
            </div>
          </div>
        </div>

        <!-- Text Content -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f1262d]/20 text-[#f1262d] text-xs font-bold uppercase tracking-wider">
            <span>Destaque Estético</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
            Revitalização de Faróis: <br />
            <span class="text-[#f1262d]">Transparência e Segurança</span>
          </h2>

          <p class="text-gray-300 text-base leading-relaxed">
            Faróis amarelados e foscos diminuem drasticamente a visibilidade noturna e desvalorizam a aparência do carro. Restauramos a lente com polimento técnico e selador protetor contra novos danos solares.
          </p>

          <!-- Benefits List -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="bg-black/40 border border-white/10 p-4 rounded-xl space-y-1">
              <div class="text-[#f1262d] font-bold text-sm">Visual Renovado</div>
              <p class="text-xs text-gray-400">Aspecto de farol novo recém tirado de fábrica.</p>
            </div>
            <div class="bg-black/40 border border-white/10 p-4 rounded-xl space-y-1">
              <div class="text-[#f1262d] font-bold text-sm">Mais Segurança</div>
              <p class="text-xs text-gray-400">Aumento real do alcance e clareza dos faróis.</p>
            </div>
            <div class="bg-black/40 border border-white/10 p-4 rounded-xl space-y-1">
              <div class="text-[#f1262d] font-bold text-sm">Valorização</div>
              <p class="text-xs text-gray-400">Excelente custo-benefício na estética veicular.</p>
            </div>
          </div>

          <!-- CTA Button -->
          <div class="pt-4">
            <a 
              href={business.getWhatsappUrl('Olá! Gostaria de agendar a revitalização dos faróis do meu veículo.')}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 bg-[#f1262d] hover:bg-[#e31e24] text-white text-base font-bold px-8 py-4 rounded-xl transition-all shadow-xl shadow-[#f1262d]/25 hover:scale-105 active:scale-95"
            >
              <span>Quero revitalizar meus faróis</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
