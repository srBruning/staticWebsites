---
import { business } from '../data/business';
---

<section id="localizacao" class="py-16 bg-[#070707] relative border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f1262d]/10 text-[#f1262d] text-xs font-bold uppercase tracking-wider">
        <span>Como Chegar</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
        Nossa <span class="text-[#f1262d]">Localização</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg">
        Fácil acesso em Caxias do Sul. Traga seu veículo para uma avaliação sem compromisso.
      </p>
    </div>

    <div class="w-full bg-[#111111] rounded-3xl border border-white/10 overflow-hidden min-h-[450px] relative flex flex-col justify-end shadow-2xl">
      <div class="absolute inset-0 bg-[#070707]">
        <iframe 
          title="Mapa da Auto Recuperadora Bruning"
          src="https://maps.google.com/maps?q=-29.1972453,-51.2018627&t=&z=17&ie=UTF8&iwloc=&output=embed" 
          width="100%" 
          height="100%" 
          style="border:0; filter: grayscale(100%) invert(92%) contrast(83%);" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="opacity-70 hover:opacity-100 transition-opacity duration-500"
        ></iframe>
      </div>

      <div class="relative z-10 p-6 md:p-8 bg-gradient-to-t from-black via-black/80 to-transparent">
        <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6">
          <div>
            <h4 class="text-xl md:text-2xl font-bold text-white mb-2">Esplanada, Caxias do Sul / RS</h4>
            <p class="text-sm text-gray-300 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#f1262d]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {business.address.full}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <a 
              href={business.address.wazeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 md:flex-none inline-flex justify-center items-center gap-2 bg-[#33ccff] text-black font-bold text-sm px-6 py-3.5 rounded-xl hover:bg-[#2cb4e3] transition-colors shadow-lg"
            >
              <span>Waze</span>
            </a>
            <a 
              href={business.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 md:flex-none inline-flex justify-center items-center gap-2 bg-white text-black font-bold text-sm px-6 py-3.5 rounded-xl hover:bg-gray-200 transition-colors shadow-lg"
            >
              <span>Google Maps</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
