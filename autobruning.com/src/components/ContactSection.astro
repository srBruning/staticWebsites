---
import { business } from '../data/business';
---

<section id="contato" class="py-24 bg-[#070707] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f1262d]/10 text-[#f1262d] text-xs font-bold uppercase tracking-wider">
        <span>Fale Conosco</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
        Localização & <span class="text-[#f1262d]">Atendimento</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg">
        Venha nos visitar em Caxias do Sul ou entre em contato pelo WhatsApp para um atendimento rápido.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Contact Details Panel -->
      <div class="lg:col-span-5 bg-[#111111] rounded-3xl border border-white/10 p-8 flex flex-col justify-between space-y-8">
        
        <div class="space-y-6">
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <img src="/images/brand/logo_principal_black.png" alt="Logo Bruning" class="h-10 w-auto" />
            <div>
              <h3 class="text-lg font-bold text-white leading-tight">{business.name}</h3>
              <p class="text-xs text-[#f1262d] font-semibold">Caxias do Sul / RS</p>
            </div>
          </div>

          <!-- Address Item -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#f1262d]/10 text-[#f1262d] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Endereço</span>
              <p class="text-sm font-semibold text-white mt-0.5">{business.address.full}</p>
              <a 
                href={business.address.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-[#f1262d] font-bold hover:underline mt-1"
              >
                <span>Abrir no Google Maps</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Phone Numbers -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#f1262d]/10 text-[#f1262d] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Telefones / WhatsApp</span>
              <div class="space-y-1 mt-1">
                {business.phones.map(phone => (
                  <div class="flex items-center gap-3">
                    <a 
                      href={`https://wa.me/${phone.rawNumber}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm font-semibold text-white hover:text-[#f1262d] transition-colors"
                    >
                      {phone.label}
                    </a>
                    {phone.primary && (
                      <span class="bg-[#f1262d]/20 text-[#f1262d] text-[10px] font-bold px-2 py-0.5 rounded uppercase">
                        Principal
                      </span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Working Hours -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#f1262d]/10 text-[#f1262d] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Horário de Atendimento</span>
              <p class="text-sm font-semibold text-white mt-0.5">{business.workingHours}</p>
            </div>
          </div>

          <!-- Instagram -->
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#f1262d]/10 text-[#f1262d] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Instagram Oficial</span>
              <p class="text-sm font-semibold text-white mt-0.5">
                <a href={business.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#f1262d] transition-colors">
                  @{business.instagram}
                </a>
              </p>
            </div>
          </div>

        </div>

        <div class="pt-4">
          <a 
            href={business.getWhatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 bg-[#f1262d] hover:bg-[#e31e24] text-white font-bold py-3.5 rounded-xl transition-all shadow-md"
          >
            <span>Iniciar Conversa no WhatsApp</span>
          </a>
        </div>

      </div>

      <!-- Map Block / Location Card -->
      <div class="lg:col-span-7 bg-[#111111] rounded-3xl border border-white/10 overflow-hidden min-h-[380px] relative flex flex-col justify-end">
        <!-- Interactive Map Placeholder Background -->
        <div class="absolute inset-0 bg-[#070707]">
          <iframe 
            title="Mapa da Auto Recuperadora Bruning"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3483.58572097008!2d-51.1833!3d-29.1833!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjknMTAnOTkuOSJTIDUxwrAxMScwMC4wIlc!5e0!3m2!1spt-BR!2sbr!4v1700000000000!5m2!1spt-BR!2sbr" 
            width="100%" 
            height="100%" 
            style="border:0; filter: grayscale(100%) invert(92%) contrast(83%);" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="opacity-70 hover:opacity-100 transition-opacity"
          ></iframe>
        </div>

        <div class="relative z-10 p-6 bg-gradient-to-t from-black via-black/80 to-transparent">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h4 class="text-lg font-bold text-white">Esplanada, Caxias do Sul / RS</h4>
              <p class="text-xs text-gray-400">Rua Oscar Serafini, 91</p>
            </div>
            <a 
              href={business.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white text-black font-bold text-xs px-5 py-3 rounded-xl hover:bg-gray-200 transition-colors shrink-0"
            >
              <span>Abrir Rota GPS</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
