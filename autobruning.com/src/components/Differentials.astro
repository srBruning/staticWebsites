---
const differentials = [
  {
    title: 'Acabamento Impecável',
    desc: 'Atenção aos mínimos detalhes de brilho, reflexo e alinhamento do veículo.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />`
  },
  {
    title: 'Atendimento Direto',
    desc: 'Orçamento rápido e sem enrolação diretamente pelo WhatsApp.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`
  },
  {
    title: 'Recuperação de Colisões',
    desc: 'Correção precisa de danos de impacto mantendo a segurança estrutural.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  },
  {
    title: 'Pintura de Alta Qualidade',
    desc: 'Pigmentação fiel, estufa de secagem e proteção contra raios solar UV.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />`
  }
];
---

<section class="py-12 bg-[#111111] border-y border-white/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {differentials.map(item => (
        <div class="flex items-start gap-4 p-5 rounded-2xl bg-[#070707]/60 border border-white/5 hover:border-[#f1262d]/40 transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-[#f1262d]/10 text-[#f1262d] flex items-center justify-center shrink-0 group-hover:bg-[#f1262d] group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-white group-hover:text-[#f1262d] transition-colors">{item.title}</h3>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
