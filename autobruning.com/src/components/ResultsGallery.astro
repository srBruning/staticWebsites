---
import { galleryItems } from '../data/gallery';
import { business } from '../data/business';

const filterCategories = [
  { key: 'todos', label: 'Todos os Trabalhos' },
  { key: 'pintura', label: 'Pintura' },
  { key: 'chapeacao', label: 'Chapeação' },
  { key: 'retoques', label: 'Retoques' },
  { key: 'farois', label: 'Faróis' },
];
---

<section id="galeria" class="py-24 bg-[#070707] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f1262d]/10 text-[#f1262d] text-xs font-bold uppercase tracking-wider">
        <span>Portfólio de Serviços</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
        Galeria de <span class="text-[#f1262d]">Resultados</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg">
        Confira imagens dos veículos que passaram por nossa recuperadora em Caxias do Sul.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      {filterCategories.map(cat => (
        <button 
          type="button" 
          class={`gallery-filter-btn px-5 py-2.5 rounded-xl text-xs font-bold transition-all border ${
            cat.key === 'todos' 
              ? 'bg-[#f1262d] text-white border-[#f1262d] shadow-md shadow-[#f1262d]/20' 
              : 'bg-[#111111] text-gray-300 border-white/10 hover:border-white/30 hover:text-white'
          }`}
          data-filter={cat.key}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Gallery Grid -->
    <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {galleryItems.map(item => (
        <div 
          class="gallery-item group relative bg-[#111111] rounded-2xl overflow-hidden border border-white/10 hover:border-[#f1262d]/50 transition-all duration-300"
          data-category={item.category}
        >
          <div class="aspect-w-4 aspect-h-3 h-64 overflow-hidden relative">
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-80 group-hover:opacity-95 transition-opacity"></div>
          </div>
          
          <div class="absolute inset-x-0 bottom-0 p-5 flex flex-col justify-end space-y-1">
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#f1262d]">
              {item.categoryLabel}
            </span>
            <h3 class="text-base font-bold text-white leading-tight">
              {item.title}
            </h3>
            <p class="text-xs text-gray-300 opacity-0 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">
              {item.caption}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Footer Instagram Callout -->
    <div class="mt-16 text-center">
      <a 
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#111111] hover:bg-[#191919] text-white border border-white/20 hover:border-[#f1262d] text-sm font-bold px-8 py-4 rounded-xl transition-all shadow-lg"
      >
        <svg class="w-5 h-5 text-[#f1262d]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>Ver mais publicações no @auto_recuperadora_bruning</span>
      </a>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.gallery-filter-btn');
    const items = document.querySelectorAll('.gallery-item');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button state
        buttons.forEach(b => {
          b.classList.remove('bg-[#f1262d]', 'text-white', 'border-[#f1262d]', 'shadow-md', 'shadow-[#f1262d]/20');
          b.classList.add('bg-[#111111]', 'text-gray-300', 'border-white/10');
        });
        btn.classList.remove('bg-[#111111]', 'text-gray-300', 'border-white/10');
        btn.classList.add('bg-[#f1262d]', 'text-white', 'border-[#f1262d]', 'shadow-md', 'shadow-[#f1262d]/20');

        // Filter items
        items.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'todos' || category === filter) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
